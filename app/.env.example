# Payment Link Extractor defaults for the integrated FastAPI service
OPLL_WEB_PASSWORD=
OPLL_AT=
OPLL_CHECKOUT_PROXY=
OPLL_UPDATE_PROXY=
OPLL_STRIPE_HCAPTCHA_TOKEN= # gitleaks:allow

OPLL_COUNTRY=DE
OPLL_FORCE_COUNTRY=DE
OPLL_TASK_LIMIT=10000
OPLL_PAYMENT_METHOD=paypal
OPLL_UPDATE_CHECKOUT=true

# AutoRegister itself remains on 127.0.0.1:8000; these standalone values are
# retained for compatibility with the source package documentation.
OPLL_WEB_HOST=127.0.0.1
OPLL_WEB_PORT=18794
OPLL_TASK_WORKERS=4
OPLL_TASK_TTL_SECONDS=3600
OPLL_TASK_EVENT_HISTORY_SIZE=500

OPLL_PROXY_SOURCE_URL=
OPLL_PROXY_POOL_FILE=
IPROCKET_CHAIN_PROXY=http://127.0.0.1:18796
IPROCKET_BRIDGE_PORT=18796
IPROCKET_PRE_PROXY_HOST=127.0.0.1
IPROCKET_PRE_PROXY_PORT=3251

OPLL_LOG_LEVEL=INFO
OPLL_LOG_FILE=
OPLL_LOG_JSON=false

# PayPal Agreement Protocol sidecar. It starts lazily when the Agreement page
# opens and remains isolated from registration and payment-link workers.
PAP_HOST=127.0.0.1
PAP_PORT=18098
PAP_STARTUP_TIMEOUT_SECONDS=20
PAP_PYTHON_EXECUTABLE=
PAP_BROWSER_EXECUTABLE=
PAP_LOG_PATH=
PAP_FULL_LOGS=0

PAYPAL_HTTP_ENGINE=curl_cffi
PAYPAL_WEB_MAX_ACTIVE_JOBS=5
PAYPAL_WEB_MAX_QUEUED_JOBS=50
PAYPAL_WEB_MAX_ACTIVE_JOBS_PER_DEVICE=2
PAYPAL_WEB_OTP_TIMEOUT_SECONDS=1800
PAYPAL_MANUAL_BROWSER_LIMIT=2
PAYPAL_WEB_ENABLE_DYNAMIC_COUNTRIES=0
PAYPAL_WEB_ENABLE_PAY153_BRIDGE=0
PAYPAL_PROXY_URL=
PAYPAL_PROXY_POOL=

# HeroSMS is used only for Japan (country 182) PayPal (service ts) OTP.
HEROSMS_API_KEY=
